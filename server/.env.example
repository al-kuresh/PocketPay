# Copy to .env (git-ignored) and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Dev database. Tests ignore this and use pocketpay_test (set in vitest.config.ts).
# After pulling new migrations: npm run db:deploy
DATABASE_URL=postgresql://pocketpay:pocketpay@localhost:5433/pocketpay
# npm run db:seed creates demo accounts with a public PIN (one is an ADMIN), so it only runs
# against localhost, 127.0.0.1 or [::1]. To seed another database host on purpose, list it here
# (comma-separated, exact host names). Leave empty unless you mean it.
DEMO_SEED_ALLOWED_HOSTS=

# Signs JWTs and keys OTP hashes. Min 32 characters.
# generate: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-chars

# Dev/demo only: return the OTP in the API response instead of sending an SMS.
OTP_DEV_ECHO=true
# Demo only: new CUSTOMER accounts skip manual KYC review.
KYC_AUTO_APPROVE=false

# local = files in server/uploads (dev) · cloudinary = production
STORAGE_DRIVER=local
# Signs the 5-minute links to private files (KYC images) with STORAGE_DRIVER=local.
# Required then; min 32 characters. generate: openssl rand -base64 48
FILE_URL_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
# Required when STORAGE_DRIVER=cloudinary. Never commit the real value.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
