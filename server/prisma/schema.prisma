// PocketPay database schema — auth and money tables (docs/design.md §8.2).
// After editing: npm run db:migrate -- --name <change> && npm run db:generate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// No url here: Prisma 7 reads it from prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  AGENT
  MERCHANT
  ADMIN
}

enum UserStatus {
  PENDING_KYC
  ACTIVE
  FROZEN
  REJECTED
}

enum DocumentKind {
  NID_FRONT
  NID_BACK
  SELFIE
  PROFILE
}

enum DocumentAccess {
  PRIVATE
  PUBLIC
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  REGISTER
}

enum WalletType {
  CUSTOMER
  AGENT
  MERCHANT
  SYSTEM_FEES
  SYSTEM_FLOAT
}

enum TransactionType {
  SEND_MONEY
  CASH_IN
  CASH_OUT
  PAYMENT
  FLOAT_TOPUP
}

enum TransactionStatus {
  COMPLETED
  REVERSED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  phone             String     @unique
  nidNumber         String     @unique @map("nid_number")
  name              String
  dateOfBirth       DateTime   @map("date_of_birth") @db.Date
  shopName          String?    @map("shop_name")
  pinHash           String     @map("pin_hash")
  role              Role
  status            UserStatus @default(PENDING_KYC)
  failedPinAttempts Int        @default(0) @map("failed_pin_attempts")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz
  profilePhotoKey   String?    @map("profile_photo_key")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  documents      UserDocument[]
  kycSubmissions KycSubmission[] @relation("KycSubmitter")
  kycReviews     KycSubmission[] @relation("KycReviewer")
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]

  wallet                Wallet?
  initiatedTransactions Transaction[]

  @@map("users")
}

model UserDocument {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  kind       DocumentKind
  storageKey String         @map("storage_key")
  access     DocumentAccess
  mime       String
  sizeBytes  Int            @map("size_bytes")
  width      Int
  height     Int
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user          User            @relation(fields: [userId], references: [id])
  kycAsNidFront KycSubmission[] @relation("KycNidFront")
  kycAsNidBack  KycSubmission[] @relation("KycNidBack")
  kycAsSelfie   KycSubmission[] @relation("KycSelfie")

  @@index([userId])
  @@map("user_documents")
}

model KycSubmission {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  nidFrontId   String    @map("nid_front_id") @db.Uuid
  nidBackId    String    @map("nid_back_id") @db.Uuid
  selfieId     String    @map("selfie_id") @db.Uuid
  status       KycStatus @default(PENDING)
  reviewedById String?   @map("reviewed_by") @db.Uuid
  reason       String?
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz

  user       User         @relation("KycSubmitter", fields: [userId], references: [id])
  reviewedBy User?        @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  nidFront   UserDocument @relation("KycNidFront", fields: [nidFrontId], references: [id])
  nidBack    UserDocument @relation("KycNidBack", fields: [nidBackId], references: [id])
  selfie     UserDocument @relation("KycSelfie", fields: [selfieId], references: [id])

  @@index([userId, submittedAt])
  @@map("kyc_submissions")
}

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  attempts   Int        @default(0)
  verifiedAt DateTime?  @map("verified_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  family       String    @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  replacedById String?   @map("replaced_by") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([family])
  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Restrict: users are frozen, never deleted, and audit history must keep its actor.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

// Money tables (docs/design.md §8). Money is BigInt poisha (৳1 = 100).
// Their check constraints and triggers are raw SQL in migrations/*_ledger_core: Prisma can't
// express them, and leaves them alone in later migrations.

model Wallet {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @unique @map("user_id") @db.Uuid
  type      WalletType
  balance   BigInt     @default(0)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user                 User?         @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries              LedgerEntry[]
  sentTransactions     Transaction[] @relation("TransactionFrom")
  receivedTransactions Transaction[] @relation("TransactionTo")

  @@map("wallets")
}

model Transaction {
  id             String            @id @default(uuid()) @db.Uuid
  trxId          String            @unique @map("trx_id")
  type           TransactionType
  status         TransactionStatus @default(COMPLETED)
  amount         BigInt
  fee            BigInt            @default(0)
  fromWalletId   String            @map("from_wallet_id") @db.Uuid
  toWalletId     String            @map("to_wallet_id") @db.Uuid
  initiatedById  String            @map("initiated_by") @db.Uuid
  idempotencyKey String            @map("idempotency_key")
  note           String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  fromWallet  Wallet        @relation("TransactionFrom", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWallet    Wallet        @relation("TransactionTo", fields: [toWalletId], references: [id], onDelete: Restrict)
  initiatedBy User          @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]

  @@unique([fromWalletId, idempotencyKey])
  @@index([createdAt])
  @@index([fromWalletId, createdAt])
  @@index([toWalletId, createdAt])
  @@map("transactions")
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  // True per-wallet order: assigned at insert, under the wallet lock. created_at is the DB
  // transaction's start time, so a transfer that waited for the lock can carry an earlier one.
  seq           BigInt   @unique @default(autoincrement())
  transactionId String   @map("transaction_id") @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  amount        BigInt // signed: − debit, + credit
  balanceAfter  BigInt   @map("balance_after")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet      Wallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, seq])
  @@index([walletId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model FeeRule {
  type              TransactionType @id
  flatFee           BigInt          @default(0) @map("flat_fee")
  percentBp         Int             @default(0) @map("percent_bp")
  agentCommissionBp Int             @default(0) @map("agent_commission_bp")
  // The fee applies only when amount > this.
  minAmountForFee   BigInt          @default(0) @map("min_amount_for_fee")
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@map("fee_rules")
}

// NULL in any max* column means no limit.
model LimitRule {
  type           TransactionType @id
  minAmount      BigInt          @map("min_amount")
  maxPerTxn      BigInt?         @map("max_per_txn")
  maxCountDay    Int?            @map("max_count_day")
  maxCountMonth  Int?            @map("max_count_month")
  maxAmountDay   BigInt?         @map("max_amount_day")
  maxAmountMonth BigInt?         @map("max_amount_month")
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@map("limit_rules")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}
